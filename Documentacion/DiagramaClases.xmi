				</templateParameters>
				<properties documentation="Clase base de todos los mappers: cada MP_X traduce una entidad BE.X a su tabla. Es genérica (T es la entidad) y abstracta: no se puede instanciar, y obliga a cada mapper a implementar (override) el alta de su entidad. Además, cada uno agrega las operaciones propias que necesita (login, cierre de partida, etc.)." isSpecification="false" sType="Class" nType="1" scope="public" isRoot="false" isLeaf="false" isAbstract="true" isActive="false"/>
