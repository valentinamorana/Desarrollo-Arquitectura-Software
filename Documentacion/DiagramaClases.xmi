					<operation xmi:idref="EAID_F938B28B_88D0_41f0_B285_AF063D65AD09" name="ConexionMaster" scope="Private">
						<properties position="0"/>
						<stereotype/>
						<model ea_guid="{F938B28B-88D0-41f0-B285-AF063D65AD09}" ea_localid="1319"/>
						<type type="string" const="false" static="true" isAbstract="false" synchronised="0" concurrency="Sequential" returnarray="0" pure="0" isQuery="false"/>
						<behaviour/>
						<code/>
						<style/>
						<styleex/>
						<documentation value="El backup y el restore se hacen contra la base &quot;master&quot;, porque no se puede restaurar una base de datos mientras hay una conexión abierta contra ella misma. Por eso en el App.config hay una segunda cadena, &quot;MASTER&quot;, igual a &quot;GENERALA&quot; pero con Initial Catalog=master."/>
						<tags/>
						<parameters>
							<parameter xmi:idref="EAID_RETURNID_88D0_41f0_B285_AF063D65AD09" visibility="public">
								<properties pos="0" type="string" const="false" ea_guid="{RETURNID-88D0-41f0-B285-AF063D65AD09}"/>
								<style/>
								<styleex/>
								<documentation/>
								<tags/>
								<xrefs/>
							</parameter>
						</parameters>
						<xrefs/>
					</operation>
					<operation xmi:idref="EAID_E3B9BEBB_0410_4254_933A_F986CF6592D7" name="EscaparRuta" scope="Private">
						<properties position="1"/>
						<stereotype/>
						<model ea_guid="{E3B9BEBB-0410-4254-933A-F986CF6592D7}" ea_localid="1318"/>
						<type type="string" const="false" static="true" isAbstract="false" synchronised="0" concurrency="Sequential" returnarray="0" pure="0" isQuery="false"/>
						<behaviour/>
						<code/>
						<style/>
						<styleex/>
						<documentation value="BACKUP/RESTORE no se pueden parametrizar con SqlParameter, así que la ruta se concatena a mano. Se escapan las comillas simples para que un nombre de archivo con un ' no pueda cerrar el string y meter SQL propio en el medio."/>
						<tags/>
						<parameters>
							<parameter xmi:idref="EAID_RETURNID_0410_4254_933A_F986CF6592D7" visibility="public">
								<properties pos="0" type="string" const="false" ea_guid="{RETURNID-0410-4254-933A-F986CF6592D7}"/>
								<style/>
								<styleex/>
								<documentation/>
