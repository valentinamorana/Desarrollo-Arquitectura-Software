							</parameter>
						</parameters>
						<xrefs/>
					</operation>
					<operation xmi:idref="EAID_E8C412A5_0D25_452f_9C6F_F621C3C3EDA3" name="CarpetaBackupPorDefecto" scope="Public">
						<properties position="2"/>
						<stereotype/>
						<model ea_guid="{E8C412A5-0D25-452f-9C6F-F621C3C3EDA3}" ea_localid="1317"/>
						<type type="string" const="false" static="true" isAbstract="false" synchronised="0" concurrency="Sequential" returnarray="0" pure="0" isQuery="false"/>
						<behaviour/>
						<code/>
						<style/>
						<styleex/>
						<documentation value="El BACKUP/RESTORE lo ejecuta el servicio de SQL Server, no el usuario de Windows, así que en carpetas personales (Escritorio, Documentos) suele no tener permiso. La carpeta de backups de la instancia siempre es accesible para el servicio. Devuelve &quot;&quot; si no se pudo averiguar (versiones viejas de SQL Server)."/>
						<tags/>
						<parameters>
							<parameter xmi:idref="EAID_RETURNID_0D25_452f_9C6F_F621C3C3EDA3" visibility="public">
								<properties pos="0" type="string" const="false" ea_guid="{RETURNID-0D25-452f-9C6F-F621C3C3EDA3}"/>
								<style/>
								<styleex/>
								<documentation/>
								<tags/>
								<xrefs/>
							</parameter>
						</parameters>
						<xrefs/>
					</operation>
