<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Si SQL Server está instalado con otro nombre de instancia, cambiar solo el Data Source acá. -->
        <add name="GENERALA" connectionString="Data Source=.\SQLEXPRESS; Initial Catalog=GENERALA; Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
